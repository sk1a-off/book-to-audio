{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/tts-quality/blind-session-v1.schema.json",
  "title": "Blind TTS A/B preference session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "rated_at", "method", "reveal_mapping_path", "cases"],
  "properties": {
    "schema_version": {"const": "tts-quality-blind-session-v1"},
    "session_id": {"type": "string", "minLength": 1},
    "rated_at": {"type": "string", "format": "date-time"},
    "method": {"type": "string", "minLength": 1},
    "reveal_mapping_path": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "preferred_label", "verdict", "notes"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "preferred_label": {"type": ["string", "null"], "enum": ["A", "B", null]},
          "verdict": {"enum": ["preference", "tie", "both_bad"]},
          "notes": {"type": "string", "maxLength": 1000},
          "dimension_ratings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pronunciation": {"$ref": "#/$defs/dimensionRating"},
              "prosody": {"$ref": "#/$defs/dimensionRating"},
              "speaker_stability": {"$ref": "#/$defs/dimensionRating"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "dimensionRating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred_label", "verdict"],
      "properties": {
        "preferred_label": {"type": ["string", "null"], "enum": ["A", "B", null]},
        "verdict": {"enum": ["preference", "tie", "both_bad"]}
      }
    }
  }
}
