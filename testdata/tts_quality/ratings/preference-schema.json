{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/tts-quality/blind-preference-v1.schema.json",
  "title": "Blind TTS preference result without invented MOS scores",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "rated_on", "method", "raw_response", "interpretation", "cases", "summary", "decision"],
  "properties": {
    "schema_version": {"const": "tts-quality-blind-preference-v1"},
    "session_id": {"type": "string", "minLength": 1},
    "rated_on": {"type": "string", "format": "date"},
    "method": {"type": "string", "minLength": 1},
    "raw_response": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "interpretation": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "preferred_label", "preferred_condition", "verdict"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "preferred_label": {"type": ["string", "null"], "enum": ["A", "B", null]},
          "preferred_condition": {"type": ["string", "null"], "enum": ["sparse_u0301", "unmarked", null]},
          "verdict": {"enum": ["sparse_wins", "unmarked_wins", "tie_assumed", "both_bad"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sparse_u0301_wins", "unmarked_wins", "ties_assumed", "both_bad"],
      "properties": {
        "sparse_u0301_wins": {"type": "integer", "minimum": 0},
        "unmarked_wins": {"type": "integer", "minimum": 0},
        "ties_assumed": {"type": "integer", "minimum": 0},
        "both_bad": {"type": "integer", "minimum": 0}
      }
    },
    "decision": {"type": "string", "minLength": 1}
  }
}
