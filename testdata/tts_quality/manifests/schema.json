{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/tts-quality/sample-manifest-v1.schema.json",
  "title": "TTS quality sample manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "case_id",
    "corpus_version",
    "source_text",
    "tts_text",
    "engine",
    "model",
    "model_revision",
    "inference_config",
    "speaker_reference_sha256",
    "artifact",
    "timing",
    "worker_response",
    "chunks"
  ],
  "properties": {
    "schema_version": {"const": "tts-quality-sample-v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "corpus_version": {"type": "string", "minLength": 1},
    "source_text": {"type": "string", "minLength": 1},
    "tts_text": {"type": "string", "minLength": 1},
    "normalizer_version": {"type": ["string", "null"]},
    "segmenter_version": {"type": ["string", "null"]},
    "engine": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "seed": {"type": ["integer", "null"]},
    "inference_config": {"type": "object"},
    "speaker_reference_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "pcm_sha256", "worker_reported_pcm_sha256", "codec", "sample_rate_hz", "channels"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pcm_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "worker_reported_pcm_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "codec": {"type": "string", "minLength": 1},
        "sample_rate_hz": {"type": "integer", "minimum": 8000},
        "channels": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "peak_dbfs": {"type": ["number", "null"]},
        "rms_dbfs": {"type": ["number", "null"]},
        "lufs_i": {"type": ["number", "null"]},
        "clipping_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "silence_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "leading_silence_seconds": {"type": ["number", "null"], "minimum": 0},
        "trailing_silence_seconds": {"type": ["number", "null"], "minimum": 0},
        "contains_nan_or_inf": {"type": ["boolean", "null"]}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_seconds", "audio_seconds", "rtf"],
      "properties": {
        "preprocessing_seconds": {"type": ["number", "null"], "minimum": 0},
        "tokenization_seconds": {"type": ["number", "null"], "minimum": 0},
        "inference_seconds": {"type": ["number", "null"], "minimum": 0},
        "vocoder_seconds": {"type": ["number", "null"], "minimum": 0},
        "audio_io_seconds": {"type": ["number", "null"], "minimum": 0},
        "generation_seconds": {"type": "number", "minimum": 0},
        "audio_seconds": {"type": "number", "exclusiveMinimum": 0},
        "rtf": {"type": "number", "minimum": 0},
        "peak_vram_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "worker_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_duration_ms", "audio_duration_ms", "seed_used", "voice_cache_hit", "warnings"],
      "properties": {
        "generation_duration_ms": {"type": "integer", "minimum": 0},
        "audio_duration_ms": {"type": "integer", "minimum": 0},
        "seed_used": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "voice_cache_hit": {"type": ["boolean", "null"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "request_id", "text", "seed", "pcm_sha256", "worker_reported_pcm_sha256", "audio_duration_ms", "generation_duration_ms", "warnings"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "request_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "pcm_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "worker_reported_pcm_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "audio_duration_ms": {"type": "integer", "minimum": 0},
          "generation_duration_ms": {"type": "integer", "minimum": 0},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
